{
  "manifest_version": 3,
  "name": "DesInspect",
  "version": "0.2.1",
  "description": "Persistent browser element inspector with auto-save. Never lose your CSS/HTML tweaks again.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/dom-serializer.js",
        "storage/local-db.js",
        "content/selector-engine.js",
        "content/change-tracker.js",
        "content/overlay-renderer.js",
        "content/inspector.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "DesInspect"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
